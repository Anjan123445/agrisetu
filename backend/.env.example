# Copy to .env for local dev. On Cloud Run, set these as env vars/secrets
# in the deploy script instead (see deploy.sh) — don't bake secrets into
# the image.

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Firebase ---
# No key file needed anywhere — org policy blocks service account key
# creation, so auth is via Application Default Credentials (ADC) both
# locally and on Cloud Run.
#   Local:     run `gcloud auth application-default login` once (see README).
#   Cloud Run: grant the runtime service account roles/datastore.user;
#              ADC is picked up automatically from the metadata server.
FIREBASE_PROJECT_ID=project-4fd7204c-297a-4c1b-b21

# --- CORS ---
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173,https://agrisetu-frontend.web.app

ENV=development
